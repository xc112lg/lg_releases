--- a/drivers/net/wireless/bcmdhd/src/wl/sys/wl_cfg80211.c	2026-08-10 04:36:56.290066194 +0000
+++ b/drivers/net/wireless/bcmdhd/src/wl/sys/wl_cfg80211.c	2026-08-10 04:36:56.302539915 +0000
@@ -11271,6 +11271,11 @@
 
 	ndev = cfgdev_to_wlc_ndev(cfgdev, cfg);
 
+	if (unlikely(!ndev)) {
+		WL_ERR(("wl_notify_mic_status: ndev is NULL, dropping stale event\n"));
+		return 0;
