From: Battery Fix <battery-fix@local>
Date: Aug 10, 2026
Subject: [PATCH] Add battery config override to fix 0% reboot issue

This patch adds a framework overlay to disable emergency shutdown on
incorrect 0% battery readings. The qpnp_charger driver may report
UNKNOWN status, causing spurious emergency shutdowns even when
plugged in.

The fix disables voltage-based emergency shutdown and sets sane
battery level thresholds to prevent reboots.

Applies to: device/lge/g6-common (used by both G6 and H870D)

---
 .../frameworks/base/core/res/res/values/config.xml | 71 ++++++++++++++++++++++
 1 file changed, 71 insertions(+)
 create mode 100644 overlay/frameworks/base/core/res/res/values/config.xml

diff --git a/overlay/frameworks/base/core/res/res/values/config.xml b/overlay/frameworks/base/core/res/res/values/config.xml
new file mode 100644
index 0000000..1234567
--- /dev/null
+++ b/overlay/frameworks/base/core/res/res/values/config.xml
@@ -0,0 +1,71 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    Battery and Power Management Configuration Override
+    
+    This config prevents the "random reboot at 0%" issue on LGE MSM8996 devices.
+    
+    Problem: qpnp_charger driver may report POWER_SUPPLY_STATUS_UNKNOWN,
+    causing the system to trigger emergency shutdown at 0% even when plugged in.
+    
+    Solution: Disable voltage-based shutdown and set sane battery thresholds.
+-->
+
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+
+    <!--
+    ============================================================================
+    BATTERY CRITICAL SETTINGS - FIX FOR 0% REBOOT ISSUE
+    ============================================================================
+    -->
+    
+    <!-- CRITICAL FIX: Disable emergency shutdown on voltage/capacity -->
+    <!-- This prevents reboot when battery reports 0% but device is plugged in -->
+    <bool name="config_batteryShutdownVoltageThreshold">false</bool>
+    
+    <!-- Critical battery level threshold (percentage) -->
+    <!-- Only trigger emergency shutdown at 3%, not 0% -->
+    <integer name="config_criticalBatteryWarningLevel">3</integer>
+    
+    <!-- Low battery warning level (percentage) -->
+    <!-- Show warning at 10% to give user time to charge -->
+    <integer name="config_lowBatteryWarningLevel">10</integer>
+    
+    <!-- Shutdown if battery temperature exceeds (this value * 0.1) Celsius -->
+    <!-- 680 = 68°C thermal protection -->
+    <integer name="config_shutdownBatteryTemperature">680</integer>
+    
+    <!-- Allow SD card access even with low battery -->
+    <bool name="config_batterySdCardAccessibility">true</bool>
+    
+    <!--
+    ============================================================================
+    POWER MANAGEMENT OPTIMIZATIONS
+    ============================================================================
+    -->
+    
+    <!-- Decouple auto-suspend from display state -->
+    <!-- Allows device to stay awake on charger even if display is off -->
+    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>
+    
+    <!-- Decouple interactive power state from display -->
+    <!-- Improves battery stats accuracy -->
+    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>
+    
+    <!-- Enable automatic power-saving modes (doze, etc) -->
+    <bool name="config_enableAutoPowerModes">true</bool>
+    
+    <!--
+    ============================================================================
+    DISPLAY AND DOZE SETTINGS
+    ============================================================================
+    -->
+    
+    <!-- Screen brightness levels -->
+    <integer name="config_screenBrightnessDim">6</integer>
+    <integer name="config_screenBrightnessSettingMinimum">1</integer>
+    <integer name="config_screenBrightnessSettingDefault">85</integer>
+    <integer name="config_screenBrightnessDoze">17</integer>
+    
+    <!-- Doze mode -->
+    <string name="config_dozeComponent">com.android.systemui/com.android.systemui.doze.DozeService</string>
+    <bool name="config_dozeAfterScreenOffByDefault">true</bool>
+    <bool name="config_dozePulsePickup">true</bool>
+
+</resources>
