+	 * dereference at virtual address 0x2, PC at
+	 * wl_notify_rx_mgmt_frame). Initialize both up front from the
+	 * actual event data, and validate rxframe/mgmt_frame_len before
+	 * touching rxframe->channel at all.
+	 */
+	event = ntoh32(e->event_type);
 
-	if (mgmt_frame_len < sizeof(wl_event_rx_frame_data_t)) {
+	if (!rxframe || mgmt_frame_len < sizeof(wl_event_rx_frame_data_t)) {
 		WL_ERR(("wrong datalen:%d\n", mgmt_frame_len));
 		return -EINVAL;
 	}
 	mgmt_frame_len -= sizeof(wl_event_rx_frame_data_t);
+	channel = ((ntoh16(rxframe->channel) & WL_CHANSPEC_CHAN_MASK));
 
